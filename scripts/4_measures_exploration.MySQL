/*
===============================================================================
Measures Exploration (Key Metrics)
===============================================================================
Purpose:
    - To calculate aggregated metrics (e.g., totals, averages) for quick insights.
    - To identify overall trends or spot anomalies.

SQL Functions Used:
    - COUNT(), SUM(), AVG()
===============================================================================
*/

-- Find the Total Sales
SELECT SUM(sales_amount) AS total_sales
FROM dwh_gold.fact_sales;

-- Find how many items are sold
SELECT SUM(quantity) AS total_quantity
FROM dwh_gold.fact_sales;

-- Find the average selling price
SELECT AVG(price) AS avg_price
FROM dwh_gold.fact_sales;

-- Find the total number of orders
SELECT COUNT(order_number) AS total_orders
FROM dwh_gold.fact_sales;

SELECT COUNT(DISTINCT order_number) AS total_orders
FROM dwh_gold.fact_sales;

-- Find the total number of products
SELECT COUNT(product_key) AS total_products
FROM dwh_gold.dim_produts;

-- Find the total number of customers
SELECT COUNT(customer_key) AS total_customers
FROM dwh_gold.dim_customers;

-- Find the total number of customers that has placed an order
SELECT COUNT(DISTINCT customer_key) AS total_customers
FROM dwh_gold.fact_sales;

-- Generate a Report that shows all key metrics of the business
SELECT 'Total Sales' AS measure_name, CAST(SUM(sales_amount) AS SIGNED) AS measure_value FROM dwh_gold.fact_sales
UNION ALL
SELECT 'Total Quantity', CAST(SUM(quantity) AS SIGNED) FROM dwh_gold.fact_sales
UNION ALL
SELECT 'Average Price', ROUND(AVG(price), 0) FROM dwh_gold.fact_sales
UNION ALL
SELECT 'Total Orders', CAST(COUNT(DISTINCT order_number) AS SIGNED) FROM dwh_gold.fact_sales
UNION ALL
SELECT 'Total Products', CAST(COUNT(DISTINCT product_name) AS SIGNED) FROM dwh_gold.dim_produts
UNION ALL
SELECT 'Total Customers', CAST(COUNT(customer_key) AS SIGNED) FROM dwh_gold.dim_customers;
